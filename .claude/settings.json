{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/check_encoding.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(*.chm)",
      "Edit(*.chm)",
      "Write(*.chm)"
    ]
  }
}
